{
  "manifest_version": 3,
  "name": "erst_dev_adblocker",
  "version": "0.3",
  "description": "Блокировщик рекламы",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/domain-cosmetic.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["rules/cosmetic-map.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "erst_dev_adblocker",
    "default_popup": "popup/popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_ruleset",
        "enabled": false,
        "path": "rules/ads.json"
      },
      {
        "id": "exceptions_ruleset",
        "enabled": false,
        "path": "rules/exceptions.json"
      },
      {
        "id": "manual_ruleset",
        "enabled": false,
        "path": "rules/manual.json"
      }
    ]
  }
}