{
  "manifest_version": 3,
  "minimum_chrome_version": "105",
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "1.2.1",
  "description": "__MSG_appDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": [
        "content/lib/state.js",
        "content/lib/inject-css.js",
        "content/lib/spa.js",
        "content/lib/ad-markers.js",
        "content/lib/observer.js",
        "content/lib/auto-skip.js",
        "content/domain-cosmetic.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "erst_dev AdBlocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_ruleset",
        "enabled": false,
        "path": "rules/ads.json"
      },
      {
        "id": "exceptions_ruleset",
        "enabled": false,
        "path": "rules/exceptions.json"
      },
      {
        "id": "manual_ruleset",
        "enabled": false,
        "path": "rules/manual.json"
      }
    ]
  }
}